{
	"name": "movie-tracker",
	"private": true,
	"type": "module",
	"license": "MIT",
	"scripts": {
		"dev": "react-router dev",
		"build": "react-router build",
		"preview": "pnpm run build && vite preview",
		"typecheck": "wrangler types && react-router typegen && tsc -b",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"postinstall": "wrangler types"
	},
	"dependencies": {
		"arctic": "^3.7.0",
		"drizzle-orm": "^0.45.4",
		"isbot": "^5.1.36",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.4.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.63.0",
		"@cloudflare/vitest-plugin": "^1.3.7",
		"@eslint/js": "^10.0.1",
		"@react-router/dev": "^8.4.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^22",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.12.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.13.0",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.0.3",
		"vitest": "^4.1.11",
		"wrangler": "^4.148.0"
	},
	"packageManager": "pnpm@10.16.1",
	"engines": {
		"node": ">=22"
	}
}
