        "user_movies_status_check": {
          "name": "user_movies_status_check",
          "value": "\"user_movies\".\"status\" IN ('INTERESTED', 'WANT_TO_WATCH', 'WATCHED', 'SKIPPED')"
        },
        "user_movies_preferred_medium_check": {
          "name": "user_movies_preferred_medium_check",
          "value": "\"user_movies\".\"preferred_medium\" IS NULL OR \"user_movies\".\"preferred_medium\" IN ('THEATER', 'STREAMING', 'RENTAL', 'ANY', 'NONE')"
        },
        "user_movies_discovery_type_check": {
          "name": "user_movies_discovery_type_check",
          "value": "\"user_movies\".\"discovery_type\" IS NULL OR \"user_movies\".\"discovery_type\" IN ('THEATER_TRAILER', 'TV_CM', 'WEB_CM', 'SNS', 'ARTICLE', 'FRIEND', 'OTHER')"
        },
        "user_movies_watched_medium_check": {
          "name": "user_movies_watched_medium_check",
          "value": "\"user_movies\".\"watched_medium\" IS NULL OR \"user_movies\".\"watched_medium\" IN ('THEATER', 'STREAMING', 'RENTAL', 'OTHER')"
        },
        "user_movies_rating_check": {
          "name": "user_movies_rating_check",
          "value": "\"user_movies\".\"rating\" IS NULL OR (\"user_movies\".\"rating\" BETWEEN 1 AND 5)"
        }
